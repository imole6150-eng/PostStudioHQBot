# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Locally this defaults to a SQLite file. On Railway, add a Postgres
# plugin and it will auto-set this variable for you (recommended for
# production, since Railway's filesystem is not guaranteed persistent).
DATABASE_URL=sqlite:///poststudio.db

# Optional: your own numeric Telegram user ID. If set, only you can use
# the bot. Leave blank while testing, get your ID from @userinfobot.
OWNER_TELEGRAM_ID=
